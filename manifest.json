{
  "manifest_version": 3,
  "name": "NEON//DECK",
  "version": "1.0.1",
  "author": "Frnllk",
  "homepage_url": "https://github.com/Frnllk/neon-deck",
  "description": "Киберпанк-HUD новая вкладка: живая сцена, закладки, погода, поиск, задачи.",
  "icons": {
    "48": "icons/logo.svg",
    "96": "icons/logo.svg",
    "128": "icons/logo-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "optional_permissions": ["bookmarks"],
  "browser_specific_settings": {
    "gecko": {
      "id": "neon-deck@frnllk",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["locationInfo", "bookmarksInfo"] }
    }
  }
}
